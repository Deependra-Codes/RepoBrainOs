root = true

[*.{md,json,yml,yaml,toml,ts,tsx,js,mjs,cjs,rs,py,ps1}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
